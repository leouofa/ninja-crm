<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4"
       data-controller="modal"
       data-action="click->modal#backdropClick">
    <div class="bg-white rounded-xl shadow-xl border border-slate-200 w-full max-w-lg overflow-hidden transform transition-all">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-900">
          <%= contact.persisted? ? "Edit Contact" : "New Contact" %>
        </h2>
        <button type="button" data-action="click->modal#close" class="text-slate-400 hover:text-slate-600 rounded-lg p-1 text-sm font-semibold">
          ✕
        </button>
      </div>

      <!-- Form Body -->
      <%= form_with model: contact, class: "p-6 space-y-4" do |f| %>
        <% if contact.errors.any? %>
          <div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-xs text-rose-700 space-y-1">
            <% contact.errors.full_messages.each do |msg| %>
              <div>• <%= msg %></div>
            <% end %>
          </div>
        <% end %>

        <div>
          <%= f.label :name, "Full Name *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.text_field :name, required: true, autofocus: true, placeholder: "e.g. Jane Doe", class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :company, "Company", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.text_field :company, placeholder: "e.g. Acme Corp", class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :role, "Role / Title", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.text_field :role, placeholder: "e.g. VP Engineering", class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :email, "Email Address", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.email_field :email, placeholder: "jane@example.com", class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :phone, "Phone Number", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.telephone_field :phone, placeholder: "+1 (555) 000-0000", class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
        </div>

        <div>
          <%= f.label :linkedin_url, "LinkedIn Profile URL", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.url_field :linkedin_url, placeholder: "https://linkedin.com/in/username", class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= f.label :notes, "Notes & Background", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.text_area :notes, rows: 3, placeholder: "Context, conversation notes, interests...", class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <!-- Footer Actions -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-3">
          <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Cancel
          </button>
          <%= f.submit contact.persisted? ? "Save Changes" : "Create Contact", class: "px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
