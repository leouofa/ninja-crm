<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4"
       data-controller="modal"
       data-action="click->modal#backdropClick">
    <div class="bg-white rounded-xl shadow-xl border border-slate-200 w-full max-w-lg overflow-hidden transform transition-all"
         data-controller="template-modal">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-900">
          <%= lead.persisted? ? "Edit Lead" : "New Lead" %>
        </h2>
        <button type="button" data-action="click->modal#close" class="text-slate-400 hover:text-slate-600 rounded-lg p-1 text-sm font-semibold">
          ✕
        </button>
      </div>

      <% if lead.new_record? && @contacts.empty? %>
        <!-- No contacts available warning -->
        <div class="p-6 text-center space-y-3">
          <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 mx-auto flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-slate-900">All contacts already have leads!</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">
            Each contact can have one lead. You can create a new contact first, or edit existing leads from the board.
          </p>
          <div class="pt-2 flex items-center justify-center gap-3">
            <button type="button" data-action="click->modal#close" class="px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg">
              Close
            </button>
            <%= link_to new_contact_path, data: { turbo_frame: "modal" }, class: "px-4 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg" do %>
              Create New Contact
            <% end %>
          </div>
        </div>
      <% else %>
        <!-- Form Body -->
        <%= form_with model: lead, class: "p-6 space-y-4" do |f| %>
          <% if lead.errors.any? %>
            <div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-xs text-rose-700 space-y-1">
              <% lead.errors.full_messages.each do |msg| %>
                <div>• <%= msg %></div>
              <% end %>
            </div>
          <% end %>

          <!-- Contact Selection -->
          <div>
            <%= f.label :contact_id, "Contact *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
            <% if lead.persisted? %>
              <div class="px-3 py-2 bg-slate-100 border border-slate-200 rounded-lg text-sm font-medium text-slate-800 flex items-center justify-between">
                <span><%= lead.contact.name %> <%= "(#{lead.contact.company})" if lead.contact.company.present? %></span>
                <span class="text-xs text-slate-400 font-normal">Contact locked</span>
              </div>
              <%= f.hidden_field :contact_id %>
            <% else %>
              <%= f.collection_select :contact_id, @contacts, :id, ->(c) { c.company.present? ? "#{c.name} (#{c.company})" : c.name }, { prompt: "Select a contact..." }, { required: true, class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
            <% end %>
          </div>

          <!-- Category Selection -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <%= f.label :category_id, "Category *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider" %>
              <button type="button"
                      data-action="click->template-modal#categoryChanged"
                      onclick="const sel = document.getElementById('lead_category_id'); sel.value = 'new'; sel.dispatchEvent(new Event('change'));"
                      class="text-xs text-indigo-600 hover:text-indigo-800 font-medium">
                + New category
              </button>
            </div>
            <%= f.select :category_id,
                         options_for_select(@categories.map { |c| [c.name, c.id] } + [["+ Add new category...", "new"]], lead.category_id),
                         { prompt: "Select category..." },
                         { id: "lead_category_id",
                           required: true,
                           data: { template_modal_target: "categorySelect", action: "change->template-modal#categoryChanged" },
                           class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
          </div>

          <!-- Inline New Category Input -->
          <div data-template-modal-target="newCategoryContainer" class="hidden p-3 bg-indigo-50/60 border border-indigo-200 rounded-lg space-y-2">
            <div class="flex items-center justify-between">
              <label class="text-xs font-semibold text-indigo-900">New Category Name</label>
              <button type="button" data-action="click->template-modal#cancelNewCategory" class="text-xs text-slate-500 hover:text-slate-700">Cancel</button>
            </div>
            <%= f.text_field :new_category_name,
                             placeholder: "e.g. Advisory, Partnerships...",
                             data: { template_modal_target: "newCategoryInput" },
                             class: "w-full text-sm px-3 py-1.5 bg-white border border-indigo-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>

          <!-- Status Selection -->
          <div>
            <%= f.label :status, "Pipeline Status *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.select :status,
                         Lead.statuses.keys.map { |s| [Lead::STATUS_LABELS[s], s] },
                         {},
                         { class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
          </div>

          <!-- Notes -->
          <div>
            <%= f.label :notes, "Lead Notes", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.text_area :notes, rows: 4, placeholder: "Key milestones, deal size, conversation points...", class: "w-full text-sm px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>

          <!-- Actions -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-3">
            <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
              Cancel
            </button>
            <%= f.submit lead.persisted? ? "Save Changes" : "Create Lead", class: "px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors cursor-pointer" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
