<div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs hover:shadow-md transition-shadow group relative <%= lead.archived? ? '' : 'cursor-grab active:cursor-grabbing' %> select-none"
     data-lead-id="<%= lead.id %>"
     <%= 'draggable="true"' unless lead.archived? %>
     <%= 'data-action="dragstart->kanban#dragStart dragend->kanban#dragEnd"' unless lead.archived? %>>

  <!-- Top row: Category Badge & Actions -->
  <div class="flex items-center justify-between gap-2 mb-2">
    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">
      <%= lead.category.name %>
    </span>

    <div class="flex items-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
      <% if lead.done? %>
        <%= button_to move_lead_path(lead, status: :archived), method: :patch, class: "p-1 text-slate-400 hover:text-amber-600 hover:bg-amber-50 rounded transition-colors", title: "Archive Lead" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
          </svg>
        <% end %>
      <% end %>

      <%= link_to edit_lead_path(lead), data: { turbo_frame: "modal" }, class: "p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded transition-colors", title: "Edit Lead" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      <% end %>

      <%= button_to lead_path(lead), method: :delete, data: { turbo_confirm: "Remove lead for #{lead.contact.name}? (Contact will remain in database)" }, class: "p-1 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded transition-colors", title: "Delete Lead" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    </div>
  </div>

  <!-- Contact Name & Company -->
  <div class="mb-2">
    <h4 class="text-sm font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors">
      <%= link_to lead.contact.name, contacts_path(q: lead.contact.name), class: "hover:underline inline-block", draggable: false %>
    </h4>
    <% if lead.contact.role.present? || lead.contact.company.present? %>
      <p class="text-xs text-slate-500 truncate">
        <%= [lead.contact.role, lead.contact.company].compact_blank.join(" at ") %>
      </p>
    <% end %>
  </div>

  <!-- Contact quick links -->
  <% if lead.contact.email.present? || lead.contact.linkedin_url.present? %>
    <div class="flex items-center gap-3 text-xs text-slate-500 mb-2.5">
      <% if lead.contact.email.present? %>
        <a href="mailto:<%= lead.contact.email %>" class="hover:text-indigo-600 hover:underline flex items-center gap-1" title="<%= lead.contact.email %>">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="truncate max-w-[120px]"><%= lead.contact.email %></span>
        </a>
      <% end %>
      <% if lead.contact.linkedin_url.present? %>
        <a href="<%= lead.contact.linkedin_url %>" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 hover:underline flex items-center gap-1 text-sky-600">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          <span>LinkedIn</span>
        </a>
      <% end %>
    </div>
  <% end %>

  <!-- Notes Snippet -->
  <% if lead.notes.present? %>
    <p class="text-xs text-slate-600 bg-slate-50 border border-slate-100 rounded-md p-2 mb-3 line-clamp-2" title="<%= lead.notes %>">
      <%= lead.notes %>
    </p>
  <% end %>

  <!-- Bottom: Quick status move buttons -->
  <% if lead.archived? %>
    <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <span class="text-[11px] font-medium text-slate-400">Archived</span>
      <%= button_to move_lead_path(lead, status: :done), method: :patch, class: "inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-semibold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 transition-colors", title: "Restore to Done" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Restore to Done</span>
      <% end %>
    </div>
  <% else %>
    <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <span class="text-[11px] text-slate-400">Move:</span>
      <div class="flex items-center gap-1">
        <% %w[backlog in_progress done].each do |st| %>
          <% if st != lead.status %>
            <%= button_to move_lead_path(lead, status: st), method: :patch, class: "px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors" do %>
              <%= Lead::STATUS_LABELS[st] %>
            <% end %>
          <% end %>
        <% end %>
        <% if lead.done? %>
          <%= button_to move_lead_path(lead, status: :archived), method: :patch, class: "inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 transition-colors", title: "Archive Lead" do %>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
            <span>Archive</span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
